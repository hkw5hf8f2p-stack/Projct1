{
  "name": "sitelens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "doctor:as-sitelens": "SL_PASS_PROXY=1 bash scripts/run-as-sitelens.sh pnpm run doctor",
    "spike": "tsx scripts/spike.ts",
    "slice": "tsx packages/browser/src/run-slice.ts",
    "audit:fixture": "tsx scripts/audit-fixture.ts",
    "audit:metamorphic": "tsx scripts/audit-metamorphic.ts",
    "audit:live": "tsx scripts/audit-live.ts",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "llm:prompts:lock": "tsx scripts/llm-prompts-lock.ts",
    "llm:replay:record": "tsx scripts/llm-replay-record.ts",
    "db:start": "tsx packages/db/src/cli.ts start",
    "db:stop": "tsx packages/db/src/cli.ts stop",
    "db:status": "tsx packages/db/src/cli.ts status",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "api": "tsx apps/api/src/index.ts",
    "web": "pnpm --filter @sitelens/web dev",
    "web:fixtures": "SITELENS_SOURCE=fixture pnpm --filter @sitelens/web dev",
    "worker": "tsx apps/worker/src/index.ts",
    "fixtures": "tsx scripts/serve-fixtures.ts",
    "s2:scenarios": "tsx scripts/s2-scenarios.ts",
    "s2:secrets": "tsx scripts/s2-secrets.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "eslint": "^9.0.0",
    "lighthouse": "13.5.0",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
