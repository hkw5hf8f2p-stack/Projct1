  {
    "id": "product-glass-kettle",
    "audit_run_id": null,
    "url": "http://site-b.test:4214/product/glass-kettle",
    "page_type": "product",
    "page_type_reason": null,
    "title": "Скляний чайник — ЧистийДім",
    "http_status": 200,
    "desktop_screenshot": "pages/product-glass-kettle/1440x1000/fullpage.png",
    "mobile_screenshot": "pages/product-glass-kettle/390x844/fullpage.png",
