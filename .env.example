# SiteLens — приклад конфігурації. Скопіюйте в .env (він у .gitignore). ТУТ НЕ МАЄ БУТИ СПРАВЖНІХ СЕКРЕТІВ.

# --- База даних (embedded-postgres локально: pnpm db:start; порт — EMBEDDED_PG_PORT) ---
# Лише loopback; дефолтні облікові дані стосуються лише локального embedded-кластера в data/pg (не для спільних машин).
DATABASE_URL=postgres://sitelens:sitelens@127.0.0.1:54329/sitelens
EMBEDDED_PG_PORT=54329

# --- API ---
# За замовчуванням API слухає лише 127.0.0.1. Не-loopback HOST (напр. 0.0.0.0) дозволено ЛИШЕ разом із ACCESS_TOKEN (≥ 16 символів), інакше API не стартує.
# HOST=127.0.0.1
# PORT=3001
APP_URL=http://127.0.0.1:3000
# Порожній токен = API без автентифікації (лише loopback). Задано → потрібен заголовок Authorization: Bearer <токен> і діє ліміт аудитів на годину.
ACCESS_TOKEN=
RATE_LIMIT_PER_HOUR=20

# --- Сховище артефактів ---
ARTIFACT_DIR=./data/artifacts
ARTIFACT_TTL_DAYS=30

# --- Обмеження crawl ---
MAX_PAGES=12
MAX_CRAWL_DEPTH=3

# --- LLM (без ключа працює режим none: аудит завершується детермінованими доказами) ---
# LLM_PROVIDER=anthropic|openai|replay ; порожньо → провайдер, чий ключ є; ключів немає → none
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MAX_AUDIT_TOKENS=1650000

# --- Lighthouse ---
# LIGHTHOUSE_MAX_PAGES=3
# LIGHTHOUSE_FORM_FACTORS=desktop   # desktop|mobile, через кому
# LIGHTHOUSE_ENABLED=1

# --- Лише для локальних фікстур/тестів (заборонено при NODE_ENV=production) ---
# SITELENS_FIXTURE_MODE=1
# SITELENS_FIXTURE_ORIGINS=http://127.0.0.1:4210,http://127.0.0.1:4211
